@model IEnumerable<Persona>

<partial name="_Encabezado" />
<ul class="list-group">
    @foreach (var p in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>
                @p.Apellido, @p.Nombre
                <span class="d-block small text-muted">@p.Nacionalidad</span>
            </span>
            <partial name="_Acciones" model="new Fila(p.Id, p.NombreCompleto)" />
        </li>
    }
</ul>
