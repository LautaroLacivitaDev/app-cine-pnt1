@model List<Sala>
@{
    ViewData["Title"] = "Salas";
}

<partial name="_Encabezado" />
@foreach (var sede in Model.GroupBy(s => s.Sede!.Nombre))
{
    <h2 class="h6 mt-3">@sede.Key</h2>
    <ul class="list-group">
        @foreach (var s in sede)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <span>
                    <strong>@s.Nombre</strong>
                    @if (s.Soporta3D)
                    {
                        <span class="badge text-bg-info">3D</span>
                    }
                    <span class="d-block small text-muted">
                        @s.CantidadFilas filas × @s.ButacasPorFila butacas = @s.Capacidad lugares
                    </span>
                </span>
                <partial name="_Acciones" model="new Fila(s.Id, s.Nombre)" />
            </li>
        }
    </ul>
}
