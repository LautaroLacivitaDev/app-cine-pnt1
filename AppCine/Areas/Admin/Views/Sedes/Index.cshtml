@model List<Sede>
@{
    ViewData["Title"] = "Sedes";
}

<partial name="_Encabezado" />
<ul class="list-group">
    @foreach (var s in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>
                <strong>@s.Nombre</strong>
                <span class="d-block small text-muted">@s.Direccion@(s.Localidad is null ? "" : $", {s.Localidad}")</span>
                <span class="d-block small text-muted">
                    @s.Salas.Count salas: @string.Join(", ", s.Salas.OrderBy(x => x.Nombre).Select(x => x.Nombre))
                </span>
            </span>
            <partial name="_Acciones" model="new Fila(s.Id, s.Nombre)" />
        </li>
    }
</ul>
<a asp-controller="Salas" asp-action="Index" class="btn btn-outline-dark mt-3">Administrar salas</a>
