@model List<Funcion>
@{
    ViewData["Title"] = "Funciones";
    var pasadas = (bool)ViewBag.Pasadas;
}

<partial name="_Encabezado" />
<div class="btn-group mb-3" role="group" aria-label="Período">
    <a asp-action="Index" class="btn @(pasadas ? "btn-outline-dark" : "btn-dark")">Próximas</a>
    <a asp-action="Index" asp-route-pasadas="true" class="btn @(pasadas ? "btn-dark" : "btn-outline-dark")">Pasadas</a>
</div>
@if (Model.Count == 0)
{
    <p class="text-muted">No hay funciones.</p>
}
@foreach (var dia in Model.GroupBy(f => f.FechaHora.Date))
{
    <h2 class="h6 mt-3">@dia.Key.ToString("dddd dd/MM/yyyy")</h2>
    <ul class="list-group">
        @foreach (var f in dia)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <span>
                    <strong class="horario">@f.Etiqueta</strong> · @f.Pelicula!.Titulo
                    <span class="d-block small text-muted">
                        @f.Sala!.Sede!.Nombre · @f.Sala.Nombre · @f.Idioma.Texto() · @f.Precio.ToString("C0") · termina @f.HoraFin().ToString("HH:mm")
                    </span>
                </span>
                @if (!pasadas)
                {
                    <partial name="_Acciones" model="new Fila(f.Id, f.Pelicula.Titulo + ' ' + f.Etiqueta)" />
                }
            </li>
        }
    </ul>
}
