@model List<Distribuidora>
@{
    ViewData["Title"] = "Distribuidoras";
}

<partial name="_Encabezado" />
@if (Model.Count == 0)
{
    <partial name="_Vacio" model="@("Todavía no hay distribuidoras.")" />
}
<ul class="list-group">
    @foreach (var d in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>@d.RazonSocial</span>
            <partial name="_Acciones" model="new Fila(d.Id, d.RazonSocial)" />
        </li>
    }
</ul>
