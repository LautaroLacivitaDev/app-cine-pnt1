@model List<Genero>
@{
    ViewData["Title"] = "Géneros";
}

<partial name="_Encabezado" />
<ul class="list-group">
    @foreach (var g in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>@g.Nombre</span>
            <partial name="_Acciones" model="new Fila(g.Id, g.Nombre)" />
        </li>
    }
</ul>
