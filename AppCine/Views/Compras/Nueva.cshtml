@model CompraViewModel
@{
    var f = Model.Funcion;
    var pelicula = f.Pelicula!;
    var sala = f.Sala!;
    var bloqueada = Model.Bloqueo is not null;
    ViewData["Title"] = $"Entradas para {pelicula.Titulo}";
}

<a asp-controller="Peliculas" asp-action="Detalle" asp-route-id="@pelicula.Id" class="btn btn-link px-0 mb-2">← Volver a la película</a>

<h1 class="h3 mb-1">@pelicula.Titulo</h1>
<p class="text-muted mb-3">
    <span class="badge text-bg-secondary">@pelicula.Clasificacion.Texto()</span>
    @f.FechaHora.ToString("dddd dd/MM, HH:mm") · @sala.Sede!.Nombre · @sala.Nombre ·
    @f.Formato.Texto() · @f.Idioma.Texto()@(f.Subtitulada ? " subtitulada" : "") ·
    <strong class="text-body">@f.Precio.ToString("C") por entrada</strong>
</p>

@if (bloqueada)
{
    <div class="alert alert-warning" role="alert">@Model.Bloqueo</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Nueva" asp-route-id="@f.Id" method="post" id="form-compra"
      data-precio="@f.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-maximo="@Compra.MaximoEntradas">
    <div class="sala-mapa mb-3" role="group" aria-label="Butacas de la @sala.Nombre">
        <div class="pantalla">Pantalla</div>
        @for (var fila = 1; fila <= sala.CantidadFilas; fila++)
        {
            <div class="fila-butacas">
                <span class="nro-fila" aria-hidden="true">@fila</span>
                @for (var butaca = 1; butaca <= sala.ButacasPorFila; butaca++)
                {
                    var ocupada = Model.Ocupadas.Contains((fila, butaca));
                    var elegida = Model.Elegidas.Contains((fila, butaca));
                    var idButaca = $"b-{fila}-{butaca}";
                    var valor = $"{fila}-{butaca}";
                    <input type="checkbox" class="btn-check butaca-check" id="@idButaca" name="butacas"
                           value="@valor" autocomplete="off"
                           disabled="@(ocupada || bloqueada)" checked="@elegida" />
                    <label class="butaca @(ocupada ? "ocupada" : "")" for="@idButaca"
                           title="Fila @fila, butaca @butaca@(ocupada ? " (vendida)" : "")">@butaca</label>
                }
            </div>
        }
    </div>

    <div class="d-flex flex-wrap gap-3 small text-muted mb-3">
        <span><span class="butaca muestra"></span> Libre</span>
        <span><span class="butaca muestra elegida"></span> Elegida</span>
        <span><span class="butaca muestra ocupada"></span> Vendida</span>
    </div>

    @if (!bloqueada)
    {
        <div class="d-flex flex-wrap align-items-center gap-3">
            <p class="fs-5 mb-0">
                Entradas: <strong id="cantidad">@Model.Elegidas.Count</strong> ·
                Total: <strong id="total">@((Model.Elegidas.Count * f.Precio).ToString("C"))</strong>
            </p>
            <button type="submit" class="btn btn-primary btn-lg" id="btn-comprar">Comprar</button>
        </div>
        <p class="small text-muted mt-2" id="aviso-maximo">Podés elegir hasta @Compra.MaximoEntradas butacas.</p>
    }
</form>

@section Scripts {
    <script>
        // Cuenta las butacas elegidas, actualiza el total y no deja pasar el máximo.
        (function () {
            const form = document.getElementById('form-compra');
            const boton = document.getElementById('btn-comprar');
            if (!form || !boton) return;
            const precio = Number(form.dataset.precio);
            const maximo = Number(form.dataset.maximo);
            const moneda = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });
            const aviso = document.getElementById('aviso-maximo');

            function actualizar() {
                const cantidad = form.querySelectorAll('.butaca-check:checked').length;
                document.getElementById('cantidad').textContent = cantidad;
                document.getElementById('total').textContent = moneda.format(cantidad * precio);
                boton.disabled = cantidad === 0;
                aviso.classList.toggle('text-danger', cantidad >= maximo);
            }

            form.addEventListener('change', function (e) {
                if (e.target.matches('.butaca-check:checked')
                    && form.querySelectorAll('.butaca-check:checked').length > maximo) {
                    e.target.checked = false;
                }
                actualizar();
            });
            actualizar();
        })();
    </script>
}
