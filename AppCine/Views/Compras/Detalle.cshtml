@model Compra
@{
    ViewData["Title"] = $"Compra n.º {Model.Id}";
    // Las entradas se agrupan por función (con AsNoTracking cada entrada trae su propia copia de la función).
    var porFuncion = Model.Entradas.GroupBy(e => e.FuncionId).Select(g => (Funcion: g.First().Funcion!, Entradas: g.ToList()));
}

<a asp-action="Index" class="btn btn-link px-0 mb-2">← Mis compras</a>

<h1 class="h3 mb-1">Compra n.º @Model.Id</h1>
<p class="text-muted">Realizada el @Model.FechaHora.ToString("dd/MM/yyyy 'a las' HH:mm")</p>

@foreach (var grupo in porFuncion)
{
    var f = grupo.Funcion;
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-1">@f.Pelicula!.Titulo</h2>
            <p class="text-muted mb-2">
                @f.FechaHora.ToString("dddd dd/MM, HH:mm") · @f.Sala!.Sede!.Nombre (@f.Sala.Sede.Direccion) · @f.Sala.Nombre ·
                @f.Formato.Texto()@(f.Subtitulada ? " SUB" : "")
            </p>
            <ul class="list-group list-group-flush">
                @foreach (var e in grupo.Entradas.OrderBy(e => e.Fila).ThenBy(e => e.Butaca))
                {
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span>@e.Ubicacion</span>
                        <span class="horario">@e.Precio.ToString("C")</span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<p class="fs-5 text-end">Total: <strong class="horario">@Model.Total.ToString("C")</strong></p>

<a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Volver a la cartelera</a>
