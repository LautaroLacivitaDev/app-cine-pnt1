@model List<Compra>
@{
    ViewData["Title"] = "Mis compras";
}

<h1>Mis compras</h1>

@if (Model.Count == 0)
{
    <div class="vacio">
        <p class="mb-3">Todavía no compraste entradas.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ver la cartelera</a>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var c in Model)
        {
            var funcion = c.Entradas.First().Funcion!;
            var pasada = funcion.FechaHora < DateTime.Now;
            <a asp-action="Detalle" asp-route-id="@c.Id"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                <span class="d-flex align-items-center gap-3">
                    <span class="text-center" style="min-width: 3.5rem">
                        <span class="d-block dato-chico text-capitalize">@funcion.FechaHora.ToString("ddd")</span>
                        <span class="d-block marquesina fs-3">@funcion.FechaHora.ToString("dd/MM")</span>
                    </span>
                    <span>
                        <span class="d-block marquesina fs-4 @(pasada ? "text-muted" : "")">@funcion.Pelicula!.Titulo</span>
                        <span class="d-block small text-muted">
                            @funcion.FechaHora.ToString("HH:mm") en @funcion.Sala!.Sede!.Nombre, @funcion.Sala.Nombre.
                            @(c.Entradas.Count == 1 ? "1 entrada" : $"{c.Entradas.Count} entradas")
                            @if (pasada)
                            {
                                <span class="badge text-bg-light border ms-1">Ya pasó</span>
                            }
                        </span>
                    </span>
                </span>
                <span class="fw-bold horario text-nowrap">@c.Total.ToString("C0")</span>
            </a>
        }
    </div>
}
