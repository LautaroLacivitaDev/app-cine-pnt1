<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cine</title>
    <script type="importmap"></script>
    <link rel="preload" href="~/fonts/big-shoulders-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppCine.styles.css" asp-append-version="true" />
</head>
@{
    // Sección activa del menú, para marcarla con aria-current.
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Actual(bool activo) => activo ? "page" : null;
}
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark barra" aria-label="Principal">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Cine</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto gap-md-4 ms-md-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"
                               aria-current="@Actual(area is null && controlador is "Home" or "Peliculas")">Cartelera</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Compras" asp-action="Index"
                                   aria-current="@Actual(area is null && controlador is "Compras")">Mis compras</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Inicio" asp-action="Index"
                                   aria-current="@Actual(area is "Admin")">Administración</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center gap-2 pb-3 pb-md-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="saludo">Hola, @User.Identity.Name</span></li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Cuenta" asp-action="Salir" method="post">
                                    <button type="submit" class="btn btn-sm btn-salir">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Cuenta" asp-action="Ingresar"
                                   aria-current="@Actual(controlador is "Cuenta")">Ingresar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="contenido">
        <main role="main" class="container pt-4 pb-3">
            @if (TempData["Aviso"] is string aviso)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    @aviso
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="pie">
        <div class="container">
            &copy; @DateTime.Today.Year Cine. Sede Centro, Av. Corrientes 1500. Sede Norte, Av. Maipú 2200.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
