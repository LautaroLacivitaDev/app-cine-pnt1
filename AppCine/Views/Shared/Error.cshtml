@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="mx-auto" style="max-width: 36rem">
    <h1>Algo salió mal</h1>
    <p>No pudimos completar lo que pediste. Volvé a intentarlo en unos minutos.</p>
    @if (Model.ShowRequestId)
    {
        <p class="dato-chico">Código para soporte: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver a la cartelera</a>
</div>
