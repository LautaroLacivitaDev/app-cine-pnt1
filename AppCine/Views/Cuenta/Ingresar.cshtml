@model List<Usuario>
@{
    ViewData["Title"] = "Ingresar";
}

<div class="mx-auto" style="max-width: 32rem">
    <h1>Ingresar</h1>
    <p class="text-muted">Login simulado: elegí con qué usuario querés entrar.</p>
    <div class="list-group">
        @foreach (var u in Model)
        {
            <form asp-action="Ingresar" method="post" class="list-group-item list-group-item-action p-0">
                <input type="hidden" name="usuarioId" value="@u.Id" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <button type="submit" class="btn w-100 text-start fw-normal px-3 py-3 d-flex justify-content-between align-items-center gap-3 border-0">
                    <span>
                        <span class="d-block fw-bold">@u.NombreCompleto</span>
                        <span class="d-block small text-muted text-break">@u.Email, @u.Edad años</span>
                    </span>
                    @if (u.EsAdmin)
                    {
                        <span class="badge text-bg-warning">Admin</span>
                    }
                </button>
            </form>
        }
    </div>
</div>
